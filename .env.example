# Copy to .env and fill in the values. .env is git-ignored. Never commit it.

# Required. HS256 needs at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# PostgreSQL credentials, used by both the db container and the app.
DB_USER=trekops
# Required. Choose your own password.
DB_PASSWORD=

# Optional. Defaults shown match src/main/resources/application.yml.
TOKEN_TTL_MINUTES=480
DELAY_CHECK_ENABLED=true
DELAY_CHECK_INTERVAL_MS=60000
NOTIFICATION_CHANNELS=log
